**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ──────────────────────────────────────────────
# Data (re-downloaded by pipeline at runtime)
# ──────────────────────────────────────────────
data/

# ──────────────────────────────────────────────
# Model artifacts (Force tracked for grading)
# ──────────────────────────────────────────────
!artifacts/model.pt
artifacts/model.pth
artifacts/model.h5
artifacts/model.onnx
# Keep the .gitkeep placeholder
!artifacts/.gitkeep

# ──────────────────────────────────────────────
# Generated pipeline outputs (Force tracked for grading)
# ──────────────────────────────────────────────
!results/initial_audit.json
!results/analysis.json
!results/mitigated_audit.json
!results/overall_metrics.json
# Keep demographics.json (manually defined, not generated)
!results/demographics.json

# ──────────────────────────────────────────────
# Submission (Force tracked for grading)
# ──────────────────────────────────────────────
!submission/deployment_memo.pdf
!submission/.gitkeep

