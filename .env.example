# ============================================================
# Facial Verification Fairness Audit — Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed.
# The .env file is gitignored; never commit secrets.

# ----------------------------------------------------------------
# Pipeline Mode
# ----------------------------------------------------------------
# QUICK_MODE=true   → Use zero-shot pretrained FaceNet (no fine-tuning).
#                    Generates all required outputs in ~10–20 minutes.
#                    Recommended for first run and evaluation.
# QUICK_MODE=false  → Fine-tune with Triplet Loss. Takes 1–2 hours on CPU.
QUICK_MODE=true

# ----------------------------------------------------------------
# Training Hyperparameters (only used when QUICK_MODE=false)
# ----------------------------------------------------------------
EPOCHS=3
BATCH_SIZE=32
LEARNING_RATE=0.0001
TRIPLET_MARGIN=0.2

# ----------------------------------------------------------------
# GPU Configuration
# ----------------------------------------------------------------
# Leave empty to auto-detect (uses GPU if available, else CPU).
# Set to "" to force CPU even if GPU is present.
# CUDA_VISIBLE_DEVICES=0
CUDA_VISIBLE_DEVICES=

# ----------------------------------------------------------------
# Logging
# ----------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----------------------------------------------------------------
# Dataset Configuration
# ----------------------------------------------------------------
# Number of audit pairs to generate per demographic subgroup.
# Increase for more statistically robust results (slower).
AUDIT_PAIRS_PER_GROUP=200

# Maximum images to use from FairFace for faster iteration.
# Set to 0 to use the full dataset (~108K images).
MAX_IMAGES=10000
