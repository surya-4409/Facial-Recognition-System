# Exclude large generated files from Docker build context
# This prevents the 107MB model.pt and downloaded data from being sent to Docker daemon

# Downloaded dataset (can be re-downloaded inside container)
data/

# Generated model artifacts (too large for build context; generated by pipeline)
artifacts/

# Generated results (generated by pipeline)
results/initial_audit.json
results/analysis.json
results/mitigated_audit.json
results/overall_metrics.json

# Generated PDF (generated by pipeline)
submission/deployment_memo.pdf

# Python cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
.env
.venv/

# IDE and OS files
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Logs
*.log
pipeline.log

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/
